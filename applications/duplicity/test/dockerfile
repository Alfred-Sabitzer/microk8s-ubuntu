# Always use harbor.test.slainte.at/dockerhub for public images, to avoid rate limits from dockerhub
FROM harbor.test.slainte.at/dockerhub/alpine:latest

LABEL maintainer="duplicity@slainte.at"
LABEL Description="Backup s3-buckets to sshfs or vice versa using duplicity and sshfs"

# Variable
ENV LANG=de_DE.UTF-8
ENV LANGUAGE=de_DE.UTF-8
ENV LC_ALL=de_DE.UTF-8

# timezone support
ENV TZ=Europe/Vienna
RUN apk add --no-cache tzdata &&\
    cp /usr/share/zoneinfo/${TZ} /etc/localtime  &&\
    echo $TZ > /etc/timezone &&\
    rm -rf /usr/share/zoneinfo  

RUN apk add --no-cache \
    bash \
    ca-certificates \
    duplicity \
    fuse3 \
    gnupg \
    openssh-client \
    sshfs \
    sshpass \
    coreutils \
    util-linux

# Backup script
COPY backup.sh /usr/local/bin/backup.sh
RUN chmod +x /usr/local/bin/backup.sh

# create the group and user
RUN addgroup -g 1000 duplicity \
    && adduser -u 1000 -G duplicity -D duplicity

# stating USER before WORKDIR means the directory is created with the non-root proper ownership
USER duplicity
WORKDIR /home/duplicity

ENTRYPOINT ["/usr/local/bin/backup.sh"]
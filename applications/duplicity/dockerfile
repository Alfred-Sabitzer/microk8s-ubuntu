# Always use harbor.test.slainte.at/dockerhub for public images, to avoid rate limits from dockerhub
FROM harbor.test.slainte.at/dockerhub/alpine:latest

LABEL maintainer="duplicity@slainte.at"
LABEL Description="Master-Image for Backing up s3-buckets to remote destinations or vice versa using duplicity and sftp/sshfs. This image is based on alpine linux and contains duplicity, sshfs, gnupg, openssh-client, sshpass and coreutils."

# Variable
ENV LANG=de_DE.UTF-8
ENV LANGUAGE=de_DE.UTF-8
ENV LC_ALL=de_DE.UTF-8

RUN apk update && apk upgrade \
    && apk add --no-cache \
        bash \
        ca-certificates \
        coreutils \
        duplicity \
        gnupg \
        openssh-client \
        py3-paramiko \
        py3-pexpect \
        python3 \
        sshfs \
        sshpass \
        tzdata \
        util-linux

# timezone support
ENV TZ=Europe/Vienna
RUN cp /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo $TZ > /etc/timezone \
    && rm -rf /usr/share/zoneinfo

# create the group and user
RUN addgroup -g 1000 duplicity \
    && adduser -u 1000 -G duplicity -D duplicity

# stating USER before WORKDIR means the directory is created with the non-root proper ownership
USER duplicity
WORKDIR /home/duplicity

ENTRYPOINT ["sh -c | while true; do date; sleep 5; done"]
# values.yaml
cr:
  create: true
  namespace: kiali  # where Kiali will be installed
  spec:
    deployment:
      replicas: 1
      cluster_wide_access: true  # allows Kiali to see all namespaces  

    auth:
      strategy: "anonymous"

    external_services:
      prometheus:
        url: "http://kube-prom-stack-kube-prome-prometheus.observability.svc.cluster.local:9090"
      grafana:
        internal_url: "http://kube-prom-stack-grafana.observability.svc.cluster.local"

    # Optional: Kiali UI settings
    server:
      web_root: "/kiali"

service:
  type: ClusterIP
  port: 20001  # default Kiali port

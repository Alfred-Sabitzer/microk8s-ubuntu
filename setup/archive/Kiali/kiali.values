# values.yaml

cr:
  create: true
  namespace: kiali
  spec:
    auth:
      strategy: "anonymous"
    external_services:
      prometheus:
        url: "http://kube-prom-stack-kube-prome-prometheus.observability.svc.cluster.local:9090"
      grafana:
        internal_url: "http://kube-prom-stack-grafana.observability.svc.cluster.local"
        external_url: "https://${K8S_ENVIRONMENT}.grafana.slainte.at"
        auth:
          ca_file: ""
          insecure_skip_verify: false
          password: "kialipassword"
          token: ""
          type: "basic"
          use_kiali_token: false
          username: "kiali"
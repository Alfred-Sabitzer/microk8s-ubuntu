    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["--project=default", "--profile=default", "--network=default", "--image='ubuntu 24.04 LTS amd64 (minimal release) (20250727)'", "--type=minimal", "--template_dir='.template'", "--output_file=demo.yaml"]
        }
    ]
}
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: lxd template",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",            
            "args": ["--project=default", "--profile=infrastructure", "--image=alpine", "--template_dir=/home/alfred/VSCode/microk8s-ubuntu/setup/MicroCloud/InstanceGenerator/template/", "--name=demodirectory"],
            "console": "integratedTerminal",
            "python-envs.workspaceSearchPaths": ["./**/.venv"]
        }
    ]
}
